{
  "name": "showcontrol-shell",
  "productName": "Show Control",
  "version": "1.0.2",
  "description": "Thin window that loads the Show Control interface from a server.",
  "author": "Gregory Cowley",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "start:kiosk": "electron . --kiosk",
    "postinstall": "patch-package",
    "dist": "electron-builder --mac --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "patch-package": "^8.0.1"
  },
  "build": {
    "appId": "com.gcp.imr.showcontrol",
    "productName": "Show Control",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "local.js",
      "preload.js",
      "config.json",
      "pages/**",
      "ui/**"
    ],
    "mac": {
      "category": "public.app-category.education",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "notarize": true
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    },
    "publish": {
      "provider": "github",
      "owner": "gregorycowley",
      "repo": "imr-showcontrol"
    },
    "releaseInfo": {
      "releaseNotesFile": "student-release.md"
    }
  }
}
