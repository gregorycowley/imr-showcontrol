# Show Control environment
#
# Copy this file to .env and fill in values for your machine.
# .env is ignored by git; this .env.example is the committed template.
# Never put real addresses, keys, or passwords in .env.example.

# --- Server (vite.config.js) ---------------------------------------------

# Address the server listens on.
#   127.0.0.1  only this machine (default)
#   0.0.0.0    every machine on the network (room machine, shell on another Mac)
HOST=127.0.0.1
PORT=5173

# Where the show is saved. Relative to the project folder, or absolute.
# Point this outside the repo if a show contains private media paths.
SHOW_FILE=show.json

# --- Shell (shell/main.js) ------------------------------------------------

# Server the desktop shell loads the interface from.
# Overrides config.json and saved settings; the --url= flag overrides this.
SHOWCONTROL_URL=http://127.0.0.1:5173/

# --- Room machine (later phases) -----------------------------------------

# TouchDesigner machine on the room network. Not used yet.
# TD_HOST=
# TD_PORT=
